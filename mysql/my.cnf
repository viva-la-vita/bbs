# BBS MySQL 配置（挂载到容器 /etc/mysql/conf.d/bbs.cnf）
# 背景：
#   - 2026-10-10 实锤：innodb_buffer_pool_size 一直是出厂默认 128M（0.125G），
#     论坛数据装不进缓存，命中率仅 97.5%，搜索 SQL 从 0.5s 劣化到 17s，
#     全站 CPU 被拖满（mysqld 3 核 + php-fpm 6.7 核）。
#   - 2026-10-10 凌晨 mysqld 被内核 OOM 杀掉重启（OOMKilled=true），全站故障。
# 目标：查询全走内存（命中率 >99.5%），mysqld 总内存钉在 ~10G，杜绝 OOM。

[mysqld]

# InnoDB 缓冲池：从 128M 提到 8G（64 倍）。
# 24G 内存的机器：mysqld ~10G + php-fpm ~3G + 系统/其他容器 ~3G，余量充足。
innodb_buffer_pool_size = 8G

# 连接数：历史峰值 Max_used_connections = 41，上限给到 150 留足余量。
# 每个连接附带的线程缓冲约 2~10MB，此上限即内存上限的保险丝。
max_connections = 150

# 内存临时表上限：大搜索查询（MATCH + GROUP_CONCAT）依赖内存临时表，
# 128M 让它们留在内存完成，又不至于无限制膨胀。
tmp_table_size = 128M
max_heap_table_size = 128M

# 关闭 Performance Schema：表多、连接多的实例上常驻内存可达 1G+，纯开销。
# 代价：sys.* 诊断视图不可用。
performance_schema = OFF

# 排序/连接缓冲适度放大：配合上面的大缓冲池，减少磁盘排序。
join_buffer_size = 4M
sort_buffer_size = 4M

# 二进制日志只保留 7 天，防止无限堆积占磁盘。
binlog_expire_logs_seconds = 604800
